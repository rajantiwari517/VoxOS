{
  "name": "voxos",
  "version": "0.1.0",
  "description": "Voice-controlled AI desktop assistant for Windows",
  "main": "src/main/index.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "start": "concurrently -k -s first \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "voice-assistant",
    "ai",
    "desktop"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
